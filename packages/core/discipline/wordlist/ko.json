{
  "lang": "ko",
  "schema": 2,
  "entries": [
    {
      "concept": "전후 표기",
      "say": [
        "As-Is",
        "To-Be"
      ],
      "avoid": [
        {
          "label": "pair",
          "pattern": "(?<![가-힣「])(?:옛\\s*(?:→|->|=>|⇒|&rarr;|/|·|=|,|vs\\.?)\\s*새|옛\\s{2,}새|새\\s*(?:←|<-|&larr;|/|·|vs\\.?)\\s*옛)(?![가-힣」])"
        },
        {
          "label": "label-head",
          "pattern": "(?<![가-힣])[옛새](?=\\s*(?::|=|·\\s))"
        },
        {
          "label": "cell-alone",
          "pattern": "(?:^|(?<=\\s\\s)|(?<=\\|)|(?<=\\|\\s)|(?<=·\\s))[옛새](?=\\s*\\||\\s*$)"
        }
      ],
      "note": "before/after labels only. Modifiers (옛 코드 · 새 레인 · 새 `x`) and 「」-quoted mentions are not hits (contracts §Language). T-1181.",
      "cases": {
        "hit": [
          { "text": "옛 → 새" },
          { "text": "옛→새" },
          { "text": "옛 -> 새" },
          { "text": "옛 / 새" },
          { "text": "옛 · 새" },
          { "text": "새 ← 옛" },
          { "text": "옛: 레인 셋" },
          { "text": "새: 레인 넷" },
          { "text": "| 항목 | 옛 | 새 |", "kind": "md", "n": 2 },
          { "text": "| 옛 | a | b |", "kind": "md" },
          { "text": "<table><tr><th>옛</th><th>새</th></tr></table>", "kind": "html" },
          { "text": "<h2><code>prdt schedule</code> · 새</h2>", "kind": "html" }
        ],
        "miss": [
          { "text": "옛 코드" },
          { "text": "옛 배치" },
          { "text": "새 레인" },
          { "text": "새 합격선" },
          { "text": "새로 만든" },
          { "text": "새 버전" },
          { "text": "옛날" },
          { "text": "새해" },
          { "text": "새 구조" },
          { "text": "<p>새 <code>doctrine-file</code> 탭</p>", "kind": "html" },
          { "text": "| 1 | 새 `x` (주입) |", "kind": "md" },
          { "text": "옛 `<line>` 묶음", "kind": "md" },
          { "text": "<li><span class=\"rec\">새</span>일하는 방식</li>", "kind": "html" },
          { "text": "「옛 → 새」 표기는 금지" }
        ]
      }
    },
    {
      "concept": "머무르다",
      "say": [
        "남다",
        "~에만 있다"
      ],
      "avoid": [
        {
          "pattern": "머무[르른를름]|머물"
        }
      ]
    },
    {
      "concept": "착지",
      "say": [
        "도착하다",
        "저장되다",
        "반영되다"
      ],
      "avoid": [
        {
          "pattern": "착지"
        }
      ]
    },
    {
      "concept": "사람 손",
      "say": [
        "수동 작업",
        "수동 실행",
        "직접"
      ],
      "avoid": [
        {
          "pattern": "사람 ?손(?!님)"
        }
      ]
    },
    {
      "concept": "손으로",
      "say": [
        "직접",
        "수동으로"
      ],
      "avoid": [
        {
          "pattern": "손으로"
        }
      ]
    },
    {
      "concept": "모름",
      "say": [
        "<결과>: <사유> (예: 생성 실패: Solar API 응답 시간 초과)",
        "수집 전",
        "필드 없음"
      ],
      "avoid": [
        {
          "pattern": "모름|모르는 값"
        }
      ]
    },
    {
      "concept": "em dash (—)",
      "say": [
        "콜론 :",
        "문장 나누기",
        "괄호"
      ],
      "avoid": [
        {
          "pattern": "—|&mdash;|&#8212;|&#x2014;"
        }
      ],
      "except_line": [
        "^## (?:[a-z0-9]+(?:-[a-z0-9]+)* )?v\\d+(?:\\.\\d+){0,2} — ",
        "^#### [a-z0-9]+(?:-[a-z0-9]+)* — "
      ],
      "note": "contracts/fixed-paths.md heading separators (`## v<N>.<m> — <label>`, `#### <key> — <label>`) are machine-read literals and stay exempt"
    },
    {
      "concept": "덩어리",
      "say": [
        "묶음",
        "항목 n개"
      ],
      "avoid": [
        {
          "pattern": "덩어리|덩이"
        }
      ]
    },
    {
      "concept": "빚",
      "say": [
        "남은 결함",
        "미뤄 둔 작업"
      ],
      "avoid": [
        {
          "pattern": "빚"
        }
      ]
    },
    {
      "concept": "틈",
      "say": [
        "누락",
        "빠진 경로"
      ],
      "avoid": [
        {
          "pattern": "틈"
        }
      ]
    },
    {
      "concept": "새다 (정보 노출)",
      "say": [
        "노출되다",
        "표시되다"
      ],
      "avoid": [
        {
          "pattern": "새지 |새는 |샌다"
        }
      ]
    },
    {
      "concept": "되읽다",
      "say": [
        "다시 정리하다"
      ],
      "avoid": [
        {
          "pattern": "되읽"
        }
      ]
    },
    {
      "concept": "치우다",
      "say": [
        "정리하다"
      ],
      "avoid": [
        {
          "pattern": "치웠|치운"
        }
      ]
    },
    {
      "concept": "판 내기",
      "say": [
        "버전 배포"
      ],
      "avoid": [
        {
          "pattern": "판(을)? ?내(기|고|자|요|면|서|겠|려)|판을 냈"
        }
      ]
    },
    {
      "concept": "발자국",
      "say": [
        "건드린 파일"
      ],
      "avoid": [
        {
          "pattern": "발자국"
        }
      ]
    },
    {
      "concept": "축자",
      "say": [
        "원문 그대로"
      ],
      "avoid": [
        {
          "pattern": "축자"
        }
      ]
    },
    {
      "concept": "land · 합치다 (git)",
      "say": [
        "merge"
      ],
      "avoid": [
        {
          "label": "합치다",
          "pattern": "(?:브랜치|변경|작업|트랙|커밋|(?<![A-Za-z])(?:dev|main)|track/\\S+)(?:들)?(?:[을를에로]|으로)? ?합[치쳐칠친침]"
        },
        {
          "label": "land",
          "pattern": "(?:T-\\d+|트랙|track(?:/\\S+)?|브랜치|branch|(?<![A-Za-z])(?:dev|main))(?:[을를이가은는에로]|으로)? ?(?<![A-Za-z])land(?:s|ed|ing)?(?![A-Za-z])|(?<![A-Za-z])land(?:s|ed|ing)? ?(?:했|하|해|할|됐|된|되|돼|됨|함)|(?<![A-Za-z])land(?:s|ed|ing)? (?:on|to|into) (?:dev|main)(?![A-Za-z])"
        }
      ],
      "note": "the track adopt step (`prdt track merge`, tests then merge) is merge (T-1265 · T-1266). Development terms stay untranslated: merge · commit · branch · deploy. land in another sense (dev pushes land as previews) is not a hit.",
      "cases": {
        "hit": [
          { "text": "브랜치를 합쳐요" },
          { "text": "dev에 합칠게요" },
          { "text": "T-1092 land" },
          { "text": "작업을 합친 뒤" },
          { "text": "트랙을 dev로 합쳐요" },
          { "text": "main으로 합침" },
          { "text": "변경 합치기" },
          { "text": "track/T-1092 land 했어요" },
          { "text": "T-1092 를 dev에 land 해요", "n": 1 },
          { "text": "트랙 land 뒤 테스트" }
        ],
        "miss": [
          { "text": "의견을 합쳐 주세요" },
          { "text": "두 표를 합친 결과" },
          { "text": "힘을 합치면" },
          { "text": "합계" },
          { "text": "dev pushes land as previews" },
          { "text": "「land」 는 팀이 붙인 이름" },
          { "text": "`prdt track land` 는 한 버전 남아요", "kind": "md" },
          { "text": "landing 페이지" },
          { "text": "island 지도" },
          { "text": "devland 합계" }
        ]
      }
    },
    {
      "concept": "문이 잠기다",
      "say": [
        "쓰기 권한이 없다"
      ],
      "avoid": [
        {
          "pattern": "문이 잠"
        }
      ]
    },
    {
      "concept": "뒤에서 도는",
      "say": [
        "백그라운드 작업"
      ],
      "avoid": [
        {
          "pattern": "뒤에서 도"
        }
      ]
    },
    {
      "concept": "줄 (버전 기록 단위)",
      "say": [
        "제품",
        "첫 제품"
      ],
      "avoid": [
        {
          "pattern": "(기본|추가한|릴리스) ?줄"
        }
      ]
    },
    {
      "concept": "층 (기기 · 프로젝트 · 제품)",
      "say": [
        "적용 범위",
        "기기 범위 · 프로젝트 범위 · 제품 범위"
      ],
      "avoid": [
        {
          "pattern": "(기기|프로젝트|제품|공통) ?층|층 표"
        }
      ]
    },
    {
      "concept": "배치 (문서 폴더 구조)",
      "say": [
        "예전 구조",
        "새 구조"
      ],
      "avoid": [
        {
          "pattern": "(옛|예전|As-Is|To-Be|새|제품이 먼저인) ?배치"
        }
      ]
    },
    {
      "concept": "단추",
      "say": [
        "버튼"
      ],
      "avoid": [
        {
          "pattern": "(?<!「)단추(?!」)"
        }
      ],
      "note": "UI button is 버튼, never translated (T-1329). A 「」-quoted mention is not a hit.",
      "cases": {
        "hit": [
          { "text": "저장 단추를 누른다" },
          { "text": "기록 단추" },
          { "text": "단추 두 개" },
          { "text": "| 확인 단추 | 위치 |", "kind": "md" },
          { "text": "<button aria-label=\"닫기 단추\">x</button>", "kind": "html" }
        ],
        "miss": [
          { "text": "저장 버튼을 누른다" },
          { "text": "「단추」 표기는 쓰지 않는다" }
        ]
      }
    }
  ]
}
