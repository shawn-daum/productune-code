#!/usr/bin/env python3
"""prdt — productune v1 CLI launcher (T-1170).

The CLI body lives in prdt_cli.py beside this file. A script run as `python3 prdt`
is recompiled on every start (CPython caches bytecode only for imported modules),
and the body is ~20k lines, so this launcher loads the body through the import
system's source loader — which reads and writes the __pycache__ bytecode cache —
and executes it in THIS module's namespace. Every name, `__file__` and
`__name__` therefore stay what they were when the body was this file: callers that
load `prdt` with importlib and monkeypatch its globals keep working unchanged.

The body is resolved by absolute path beside the real file (symlinks followed),
and this directory goes first on sys.path so the body's sibling imports
(prdt_lanes) never resolve from the caller's cwd (T-1166 class).
"""
import os
import sys
from importlib.machinery import SourceFileLoader

_HERE = os.path.dirname(os.path.realpath(__file__))
if not sys.path or sys.path[0] != _HERE:
    sys.path.insert(0, _HERE)
_BODY = os.path.join(_HERE, "prdt_cli.py")
if not os.path.isfile(_BODY):
    sys.stderr.write(f"prdt: {_BODY} is missing — the CLI body ships beside {os.path.join(_HERE, 'prdt')}; "
                     f"re-run install.sh (`prdt update`) to restore it\n")
    sys.exit(1)
exec(SourceFileLoader("prdt_cli", _BODY).get_code("prdt_cli"), globals())
