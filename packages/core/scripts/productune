#!/usr/bin/env bash
# productune — wrapper for the PO orchestrator (Claude Code) with auto-worktree
# split when another productune is already running on the same root.
# Legacy `my-po` command name kept as compat alias (symlink to this file).
#
# Modes:
#   productune                              Spawn `claude --agent pdt-po`
#   productune gc                           (alias: --cleanup) audit productune/* worktrees, dry-run
#   productune gc -y                        (alias: --auto, --yes) audit, then remove safe ones
#   productune init                         Scaffold project: .productune/po-state.json, docs/pdt-*/, .gitignore
#   productune onboard                      Run install.sh — wire agents, hooks, PATH
#   productune uninstall                    Remove all installed artifacts
#
# Claude Code is the only supported PO engine — PreToolUse/PostToolUse hooks
# (R1/R4 dispatch guards, state-write, doctrine re-inject) only fire there.
#
# Decision basis for cleanup is purely git state. PO process state (alive,
# crashed, exited cleanly) is irrelevant — a worktree is "safe to remove"
# only if its content is preserved elsewhere (merged into base or pushed).

set -euo pipefail

say()  { printf '\033[1;34m[productune]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[productune]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[productune]\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------- shared audit + remove ----------------
# Globals populated by audit_worktrees:
declare -a SAFE_WTS=()
declare -a SAFE_BRANCHES=()
AMBIG_COUNT=0
UNSAFE_COUNT=0
TOTAL_COUNT=0

audit_worktrees() {
  local ROOT="$1"
  local VERBOSE="${2:-0}"
  local BASE=""
  for cand in origin/main origin/master main master; do
    if git -C "$ROOT" rev-parse --verify "$cand" >/dev/null 2>&1; then
      BASE="$cand"; break
    fi
  done
  if [ -z "$BASE" ] && [ "$VERBOSE" = 1 ]; then
    warn "no main/master ref found; everything will look unmerged"
  fi

  SAFE_WTS=()
  SAFE_BRANCHES=()
  AMBIG_COUNT=0
  UNSAFE_COUNT=0
  TOTAL_COUNT=0

  local WT="" BR=""
  while IFS= read -r LINE; do
    case "$LINE" in
      "worktree "*)        WT="${LINE#worktree }" ;;
      "branch refs/heads/"*) BR="${LINE#branch refs/heads/}" ;;
      "")
        if [ -n "$WT" ] && [ -n "$BR" ] && [[ "$BR" == productune/* || "$BR" == my-po/* ]]; then
          TOTAL_COUNT=$((TOTAL_COUNT+1))

          local DIRTY=0
          [ -n "$(git -C "$WT" status --porcelain 2>/dev/null)" ] && DIRTY=1

          local ALL_MERGED=0
          if [ -n "$BASE" ] \
             && git -C "$WT" merge-base --is-ancestor HEAD "$BASE" 2>/dev/null; then
            ALL_MERGED=1
          fi

          local PUSHED=0; local UPSTREAM=""
          if UPSTREAM=$(git -C "$WT" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null); then
            if git -C "$WT" merge-base --is-ancestor HEAD "$UPSTREAM" 2>/dev/null; then
              PUSHED=1
            fi
          fi

          local STATUS="" REASON=""
          if [ "$ALL_MERGED" = 1 ] && [ "$DIRTY" = 0 ]; then
            STATUS="✓"; REASON="clean; all content is in ${BASE:-(no base)}"
            SAFE_WTS+=("$WT"); SAFE_BRANCHES+=("$BR")
          elif [ "$ALL_MERGED" = 1 ] && [ "$DIRTY" = 1 ]; then
            STATUS="⚠"; REASON="DIRTY (uncommitted), but committed history is in ${BASE}"
            AMBIG_COUNT=$((AMBIG_COUNT+1))
          elif [ "$PUSHED" = 1 ] && [ "$DIRTY" = 0 ]; then
            STATUS="⚠"; REASON="clean; unmerged commits, pushed to ${UPSTREAM}"
            AMBIG_COUNT=$((AMBIG_COUNT+1))
          elif [ "$PUSHED" = 1 ] && [ "$DIRTY" = 1 ]; then
            STATUS="⚠"; REASON="DIRTY; unmerged commits pushed to ${UPSTREAM}"
            AMBIG_COUNT=$((AMBIG_COUNT+1))
          else
            STATUS="❌"
            if [ "$DIRTY" = 1 ]; then
              REASON="DIRTY; unmerged commits, NOT pushed"
            else
              REASON="unmerged commits, NOT pushed"
            fi
            UNSAFE_COUNT=$((UNSAFE_COUNT+1))
          fi

          if [ "$VERBOSE" = 1 ]; then
            printf '\n%s %s  [branch %s]\n   %s\n' "$STATUS" "$WT" "$BR" "$REASON"
            case "$STATUS" in
              "✓") printf '   → safe to remove\n' ;;
              "⚠") printf '   → ambiguous; review and remove manually if you want\n' ;;
              "❌") printf '   → DO NOT remove. Commit + push or stash first.\n      cd "%s" && git status\n' "$WT" ;;
            esac
          fi
        fi
        WT=""; BR=""
        ;;
    esac
  done < <(git -C "$ROOT" worktree list --porcelain; printf '\n')
}

remove_safe() {
  local ROOT="$1"
  local CWD_ABS; CWD_ABS="$(cd "$PWD" && pwd -P)"
  for i in "${!SAFE_WTS[@]}"; do
    local WT_PATH="${SAFE_WTS[$i]}"
    local BR_NAME="${SAFE_BRANCHES[$i]}"
    local WT_ABS; WT_ABS="$(cd "$WT_PATH" 2>/dev/null && pwd -P || echo "$WT_PATH")"
    if [ "$WT_ABS" = "$CWD_ABS" ]; then
      warn "skipping current worktree: $WT_PATH (cd elsewhere first)"
      continue
    fi
    if git -C "$ROOT" worktree remove "$WT_PATH"; then
      say "removed worktree $WT_PATH"
    else
      warn "could not remove $WT_PATH (in use? force with: git worktree remove --force \"$WT_PATH\")"
      continue
    fi
    if git -C "$ROOT" branch -D "$BR_NAME" 2>/dev/null; then
      say "removed branch $BR_NAME"
    else
      warn "branch $BR_NAME could not be deleted"
    fi
  done
}

# -------------------- cleanup mode (gc / --cleanup / uninstall) --------------------
case "${1:-}" in
  --help|-h)
    # Resolve current repo path for display
    _repo="?"
    if [ -r "$HOME/.productune/productune.env" ]; then
      _repo="$(grep -E '^PRODUCTUNE_REPO=' "$HOME/.productune/productune.env" 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '\n' || echo '?')"
    fi
    B=$(printf '\033[1m') R=$(printf '\033[0m')
    printf "
  ${B}productune${R} — AI product team orchestrator (PO on Claude Code)

  ${B}USAGE${R}
    productune [prompt...]
    productune <command> [options]

  ${B}COMMANDS${R}
    (default)          Start a PO session (claude --agent pdt-po)
    init               Scaffold project — .productune/, docs/pdt-*/, .gitignore
    onboard            Run install — wire agents, hooks, PATH
    uninstall          Remove all installed artifacts
    gc                 Audit productune/* worktrees (dry-run)
    gc -y              Remove safe worktrees automatically
    --help, -h         Show this help

  ${B}CURRENT CONFIG${R}  (~/.productune/productune.env)
    repo         %s

  ${B}PERSONAS${R}
    pdt-po           Product Owner — orchestrator
    pdt-developer    Implementation
    pdt-designer     UX / Design System
    pdt-qa           QA / Test validation

  ${B}EXAMPLES${R}
    productune init                   Scaffold a new project (run once per repo)
    productune                        Start PO session
    productune gc -y                  Clean up merged worktrees
    productune onboard                Re-run setup

" "$_repo"
    exit 0
    ;;
  onboard)
    exec bash "$(dirname "$0")/install.sh"
    ;;
  uninstall)
    exec bash "$(dirname "$0")/uninstall.sh"
    ;;
  init)
    # Project-level scaffold. Idempotent: existing files/dirs are preserved.
    # Always uses $PWD (matches `git init` / `npm init` UX) — never walks up
    # to a parent git toplevel, since the parent may belong to a different
    # project (e.g. ~/Documents/dev/ might be your personal dotfiles repo).
    # Resolve symlinks so the comparison vs `git rev-parse --show-toplevel`
    # works (macOS reports /private/var/... while $PWD may be /var/...).
    #
    # Flags:
    #   --skip-doctrine   Skip user-global doctrine bootstrap.
    #                     CI / custom doctrine environments escape hatch.
    #                     Project-level scaffold still runs normally.
    SKIP_DOCTRINE=0
    for _init_arg in "${@:2}"; do
      case "$_init_arg" in
        --skip-doctrine) SKIP_DOCTRINE=1 ;;
        *) die "unknown option: $_init_arg (usage: productune init [--skip-doctrine])" ;;
      esac
    done

    PROJECT_ROOT="$(cd "$PWD" && pwd -P)"
    GIT_TOP="$(git -C "$PROJECT_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"

    # Git initialization — productune project memory (docs/<persona>/, .productune/)
    # only stays useful if it can be tracked. If $PWD is its own git toplevel,
    # we're set. If not, run `git init` here so productune state has somewhere
    # to live. The nested-repo case (inside a parent) is opt-in to avoid surprises.
    if [ "$GIT_TOP" = "$PROJECT_ROOT" ]; then
      :   # already a git toplevel — nothing to do
    elif [ -z "$GIT_TOP" ]; then
      # Not inside any git repo — safe to init unconditionally
      git init -q "$PROJECT_ROOT"
      say "created: .git (new repo at $PROJECT_ROOT)"
    else
      # Inside a parent git repo — creating a nested repo here is opt-in
      warn "current dir is inside a parent git repo at $GIT_TOP"
      if [ -t 0 ] && [ -t 1 ]; then
        printf '\033[1;33m[productune]\033[0m create a separate git repo at %s? (recommended) [Y/n]: ' "$PROJECT_ROOT"
        read -r GIT_INIT_CHOICE || GIT_INIT_CHOICE=""
        case "$GIT_INIT_CHOICE" in
          n|N|no|NO)
            warn "skipped git init — productune state will live under the parent repo"
            ;;
          *)
            git init -q "$PROJECT_ROOT"
            say "created: .git (new repo at $PROJECT_ROOT, nested in $GIT_TOP)"
            ;;
        esac
      else
        warn "non-interactive — skipping git init (run 'git init' manually if you want a separate repo)"
      fi
    fi

    say "initializing productune project at $PROJECT_ROOT"

    # 1) .productune/po-state.json skeleton
    mkdir -p "$PROJECT_ROOT/.productune"
    STATE="$PROJECT_ROOT/.productune/po-state.json"
    if [ ! -e "$STATE" ]; then
      cat > "$STATE" <<'EOF'
{
  "schema_version": 1,
  "current_task": null,
  "past_tickets": [],
  "recent_turns": [],
  "persona_session_meta": {}
}
EOF
      say "created: .productune/po-state.json"
    else
      say "kept: .productune/po-state.json (already exists)"
    fi

    # 2) docs/pdt-*/ project-tier memory dirs (with .gitkeep so empty dirs are committed)
    for persona in pdt-designer pdt-developer pdt-qa; do
      DIR="$PROJECT_ROOT/docs/$persona"
      if [ ! -d "$DIR" ]; then
        mkdir -p "$DIR"
        : > "$DIR/.gitkeep"
        say "created: docs/$persona/"
      else
        say "kept: docs/$persona/ (already exists)"
      fi
    done

    # 3) .gitignore — productune-managed lock + transient files
    GITIGNORE="$PROJECT_ROOT/.gitignore"
    GITIGNORE_BLOCK=$'# productune\n.productune/po.lock\n.productune/logs/\n'
    if [ -f "$GITIGNORE" ]; then
      if ! grep -qE '^\.productune/po\.lock$' "$GITIGNORE"; then
        printf '\n%s' "$GITIGNORE_BLOCK" >> "$GITIGNORE"
        say "appended productune entries to .gitignore"
      else
        say "kept: .gitignore (already has productune entries)"
      fi
    else
      printf '%s' "$GITIGNORE_BLOCK" > "$GITIGNORE"
      say "created: .gitignore (productune entries)"
    fi

    # User-global doctrine bootstrap (install/update ~/.productune/ system files).
    # Skipped when --skip-doctrine is passed (CI / custom doctrine environments).
    if [ "$SKIP_DOCTRINE" = 1 ]; then
      warn "doctrine bootstrap skipped (--skip-doctrine)"
    else
      SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
      DOCTRINE_ROOT="$(cd "$SCRIPTS_DIR/.." && pwd)"
      # shellcheck source=lib/bootstrap-doctrine.sh
      source "$SCRIPTS_DIR/lib/bootstrap-doctrine.sh"
      bootstrap_user_global_doctrine "$DOCTRINE_ROOT"
    fi

    echo
    say "ready. Start a session with: productune"
    say "  • PO state will be written to .productune/po-state.json"
    say "  • Persona project memory will accumulate in docs/pdt-*/"
    exit 0
    ;;
  --cleanup|gc)
    shift
    AUTO=0
    case "${1:-}" in
      --auto|-y|--yes) AUTO=1; shift ;;
    esac

    ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" \
      || die "not in a git repo; cleanup requires git"

    audit_worktrees "$ROOT" 1
    echo
    if [ "$TOTAL_COUNT" = 0 ]; then
      say "no productune/* (or legacy my-po/*) worktrees found"
    elif [ "${#SAFE_WTS[@]}" = 0 ]; then
      say "0 worktrees safe to remove (ambiguous: $AMBIG_COUNT, unsafe: $UNSAFE_COUNT)"
    elif [ "$AUTO" = 1 ]; then
      say "removing ${#SAFE_WTS[@]} safe worktree(s)..."
      remove_safe "$ROOT"
    else
      say "${#SAFE_WTS[@]} worktree(s) safe to remove. Run 'productune gc -y' to remove them."
    fi
    exit 0
    ;;
esac

# -------------------- default mode --------------------

# 0) Source ~/.productune/productune.env so spawned sub-agents see
#    PRODUCTUNE_REPO, CLAUDE_AUTOCOMPACT_PCT_OVERRIDE, etc.
if [ -r "$HOME/.productune/productune.env" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$HOME/.productune/productune.env"
  set +a
fi

# Banner (terse, one line). Skipped when piping or non-TTY.
if [ -t 1 ] && [ -z "${PRODUCTUNE_QUIET_BANNER:-}" ]; then
  printf '\033[1;34m[productune]\033[0m engine=claude (hooks fire)\n' >&2
fi

ensure_state() {
  # $1 = project root. Migrates legacy .codex/po-state.json (pre-rename) →
  # .productune/po-state.json if found, then seeds a minimal skeleton if absent.
  local root="$1"
  mkdir -p "$root/.productune"
  if [ -f "$root/.codex/po-state.json" ] && [ ! -f "$root/.productune/po-state.json" ]; then
    mv "$root/.codex/po-state.json" "$root/.productune/po-state.json"
    say "migrated: .codex/po-state.json → .productune/po-state.json"
  fi
  if [ ! -f "$root/.productune/po-state.json" ]; then
    printf '{"schema_version":1,"current_task":null,"past_tickets":[],"recent_turns":[]}\n' \
      > "$root/.productune/po-state.json"
  fi
}

run_engine() {
  # T-PATCH-043 (AC1): `--agent pdt-po` must stay UNCONDITIONAL — including on
  # `--resume` turns passed through "$@" — so the agent system prompt + the
  # SessionStart `agent_type` survive resume (no behavior change here).
  exec claude --agent pdt-po "$@"
}

run_engine_fg() {
  # Foreground (not exec) so EXIT trap can fire after engine returns.
  # `--agent pdt-po` unconditional — survives `--resume` turns (see run_engine).
  claude --agent pdt-po "$@"
}

# 1) Resolve project root. Non-git → bypass lock + worktree, just run engine.
if ! ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)"; then
  ensure_state "$PWD"
  run_engine "$@"
fi

ensure_state "$ROOT"
LOCK="$ROOT/.productune/po.lock"

# 2) Inspect existing lock.
if [ -f "$LOCK" ]; then
  EXISTING_PID=$(jq -r '.pid // empty' "$LOCK" 2>/dev/null || true)
  if [ -n "$EXISTING_PID" ] && kill -0 "$EXISTING_PID" 2>/dev/null; then
    SLUG="productune/$(date +%Y%m%d-%H%M%S)-$$"
    PARENT="$(dirname "$ROOT")"
    BASENAME="$(basename "$ROOT")"
    WT_DIR="$PARENT/${BASENAME}-${SLUG//\//-}"
    say "another PO is running on $ROOT (pid $EXISTING_PID)"
    say "creating worktree at $WT_DIR on branch $SLUG"
    git -C "$ROOT" worktree add "$WT_DIR" -b "$SLUG"
    cd "$WT_DIR"
    exec "$0" "$@"
  else
    warn "stale lock from pid ${EXISTING_PID:-?}; reclaiming"
    rm -f "$LOCK"
  fi
fi

# 3) Acquire lock.
printf '{"pid": %s, "started_at": "%s", "cwd": "%s"}\n' \
  "$$" "$(date -u +%FT%TZ)" "$ROOT" > "$LOCK"
trap 'rm -f "$LOCK"' EXIT INT TERM

# 4) Run the chosen engine (foreground, NOT exec — so trap fires when it exits).
run_engine_fg "$@"

# 5) Post-exit auto-prompt (only when in main worktree, only if interactive).
#    Skipped if we're inside an auto-spawned productune/* (or legacy my-po/*)
#    worktree (recursive call's parent will run the prompt instead).
CURRENT_BRANCH=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [[ "$CURRENT_BRANCH" != productune/* && "$CURRENT_BRANCH" != my-po/* ]] && [ -t 0 ] && [ -t 1 ]; then
  audit_worktrees "$ROOT" 0
  if [ "${#SAFE_WTS[@]}" -gt 0 ]; then
    echo
    say "🧹 ${#SAFE_WTS[@]} productune worktree(s) safe to remove."
    if [ "$AMBIG_COUNT" -gt 0 ] || [ "$UNSAFE_COUNT" -gt 0 ]; then
      say "   (also ambiguous: $AMBIG_COUNT, unsafe: $UNSAFE_COUNT — those are left alone)"
    fi
    printf '\033[1;34m[productune]\033[0m clean up the safe ones now? [y/N] '
    REPLY=""
    if [ -r /dev/tty ]; then
      read -r REPLY < /dev/tty || REPLY=""
    fi
    case "$REPLY" in
      y|Y|yes|YES|Yes) remove_safe "$ROOT" ;;
      *) say "skipped — run 'productune gc' anytime to revisit" ;;
    esac
  fi
fi
