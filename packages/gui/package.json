{
  "name": "@productune/gui",
  "version": "0.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-locale-keys.js && bash scripts/check-locale-protected.sh && tsc --noEmit && vite build",
    "lint": "node scripts/check-locale-keys.js && bash scripts/check-locale-protected.sh",
    "check-locales": "node scripts/check-locale-keys.js && bash scripts/check-locale-protected.sh",
    "check-locale": "bash scripts/check-locale-protected.sh",
    "check-ticket-version": "node scripts/check-ticket-version.mjs",
    "smoke": "vite build && ln -sfn dist renderer && playwright test",
    "dist:mac": "pnpm run build && electron-builder --mac dmg --config electron-builder.yml"
  },
  "dependencies": {
    "@productune/core": "workspace:*",
    "i18next": "^26.0.9",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.4.1",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.6",
    "react-markdown": "^9.0.3",
    "react-zoom-pan-pinch": "^3.6.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.1.0",
    "electron-builder": "26.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-electron": "^0.28.8"
  }
}
