{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PRDT_TEST_TIMEOUT_SCALE", "PRDT_TEST_MAX_WORKERS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    }
  }
}
