# macOS
.DS_Store

# editor
.vscode/
.idea/
*.swp

# local scratch
scratch/
tmp/

# python artifacts (if you ever add a py helper here)
__pycache__/
*.pyc
.venv/

# productune-on-productune (self-dogfood) — runtime state only.
# Artifacts (.productune/briefs/, docs/prd/, docs/tickets/, docs/{designer,developer,po,qa}/) stay tracked.
.productune/po-state.json
.productune/po.lock
.productune/logs/
.productune/turns.jsonl
.productune/.cost-main-gate.json

# monorepo
node_modules
node_modules/
.turbo/
dist/
packages/*/dist/
packages/*/dist-electron/

# prdt derived index (rebuildable — design §2)
.prdt/index.db

# T-665: the one-page repo viewer is regenerated from live repo state
# (`pnpm --filter @productune/viewer viewer`) and carries docs/ content into a
# code-side file — it must not ride the code repo (PO decision, T-665 slice 2).
packages/viewer/viewer.html
# T-885: past-version ticket bodies are split into sibling data files
# (viewer.tickets-<bucket>.js) carrying the same docs/ content — same reason.
packages/viewer/viewer.tickets-*.js
